index 5939092..2ec9123 100644
--- a/distrho/src/DistrhoPluginCLAP.cpp
+++ b/distrho/src/DistrhoPluginCLAP.cpp
@@ -136,6 +136,20 @@ struct ClapEventQueue
     StringMap fStateMap;
    #if DISTRHO_PLUGIN_HAS_UI
     virtual void setStateFromUI(const char* key, const char* value) = 0;
+
+    // DSP -> UI state, which this backend never actually implemented.  updateState() was
+    // a stub that threw the value away and answered true, so the UI was handed one
+    // snapshot when it opened and nothing ever again: a plugin that pushes its display to
+    // its own UI drew a dead panel under CLAP while working under LV2.
+    //
+    // A fixed ring, written by the audio thread and drained by the UI thread in idle, so
+    // run() neither allocates nor blocks.  The value is sized for a state that is a whole
+    // list rather than a scalar, because a truncated push is worse than a dropped one --
+    // the UI cannot tell that it was short.
+    static constexpr uint32_t kStateQueueSize = 16;
+    struct StateMessage { char key[64]; char value[16384]; };
+    StateMessage fStateQueue[kStateQueueSize];
+    volatile uint32_t fStateQueueWrite = 0, fStateQueueRead = 0;
    #endif
   #endif
 
@@ -503,6 +517,19 @@ public:
                     ui->parameterChanged(i, fCachedParameters.values[i]);
                 }
             }
+
+           #if DISTRHO_PLUGIN_WANT_STATE
+            // Anything the DSP pushed since the last idle.  Drained HERE, on the UI
+            // thread, because run() must not touch the UI directly.
+            while (fPluginEventQueue->fStateQueueRead != fPluginEventQueue->fStateQueueWrite)
+            {
+                const ClapEventQueue::StateMessage& msg(
+                    fPluginEventQueue->fStateQueue[fPluginEventQueue->fStateQueueRead]);
+                ui->stateChanged(msg.key, msg.value);
+                fPluginEventQueue->fStateQueueRead =
+                    (fPluginEventQueue->fStateQueueRead + 1) % ClapEventQueue::kStateQueueSize;
+            }
+           #endif
         }
     }
 
@@ -2080,9 +2107,24 @@ private:
    #endif
 
    #if DISTRHO_PLUGIN_WANT_STATE
-    bool updateState(const char*, const char*)
+    bool updateState(const char* const key, const char* const value)
     {
+       #if DISTRHO_PLUGIN_HAS_UI
+        const uint32_t next = (fStateQueueWrite + 1) % kStateQueueSize;
+        if (next == fStateQueueRead)
+            return false;                       // full; drop rather than block
+        StateMessage& msg(fStateQueue[fStateQueueWrite]);
+        std::strncpy(msg.key, key, sizeof(msg.key) - 1);
+        msg.key[sizeof(msg.key) - 1] = '\0';
+        std::strncpy(msg.value, value, sizeof(msg.value) - 1);
+        msg.value[sizeof(msg.value) - 1] = '\0';
+        fStateQueueWrite = next;
         return true;
+       #else
+        return false;
+        // Unused without a UI to push to.
+        (void)key; (void)value;
+       #endif
     }
 
