+    #if DISTRHO_PLUGIN_HAS_UI
+    // DSP -> UI state, which this backend never had at all: the callback was passed as a
+    // nullptr, so updateStateValue() answered false to every push for the whole life of
+    // the plugin.  The UI was handed one snapshot of fStateMap when its window opened and
+    // then nothing, ever -- so a plugin that draws its own display from the DSP showed a
+    // dead panel under VST3 while working under LV2.
+    //
+    // sendStateSetToUI() cannot be called from run() and this is not a style rule: it asks
+    // the HOST to allocate a message object and then notifies across a connection point.
+    // So a fixed ring, written by the audio thread and drained on the "idle" message the
+    // view sends, which arrives on the main thread where allocating is allowed.  Same
+    // shape as the CLAP and JACK backends, for the same reason.
+    //
+    // The value is sized for a state that is a whole list rather than a scalar, because a
+    // truncated push is worse than a dropped one -- the UI cannot tell that it was short.
+    // Anything longer is refused outright and reported, which is a bug in the caller.
+    static constexpr uint32_t kStateQueueSize = 16;
+    struct StateMessage { char key[64]; char value[16384]; };
