# Build products.  Regenerate with tools/build_core.sh and make.
build/
bin/

# generated/ is a build product with one exception: the EXPORTED ARTWORK is checked in.
# The panel is lettered in a font that cannot be redistributed (CLONING.md), so a clone
# has to be able to build the panel we ship without owning it.  tools/artwork.sh
# re-exports only when the hash of an Inkscape file actually changes.
#
# Listed as generated/* rather than generated/, because git will not look inside an
# ignored DIRECTORY -- the negations below would never be read.
generated/*
!generated/artwork.stamp
!generated/panel_geometry.h
!generated/panel_geometry.json
!generated/panel_svg.h
!generated/panel_background.h
!generated/dive_pages.h
!generated/u110_cgrom.h
!generated/panel_flat.svg
# The Windows cross build keeps its own, for the reason in the Makefile's `win` target.
build-win/
bin-win/
*.o
*.d
