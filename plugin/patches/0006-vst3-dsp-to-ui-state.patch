     // ----------------------------------------------------------------------------------------------------------------
     // DPF callbacks
 
+   #if DISTRHO_PLUGIN_WANT_STATE
+    // Called from run(), so: no allocation, no locks, no blocking, and never a partial
+    // write.  One writer and one reader, so the indices need no atomics; they are volatile
+    // because the two threads are what makes them change.
+    bool updateStateValue(const char* const key, const char* const value)
+    {
+       #if DISTRHO_PLUGIN_HAS_UI
+        if (std::strlen(key) >= sizeof(fStateQueue[0].key)
+            || std::strlen(value) >= sizeof(fStateQueue[0].value))
+        {
+            d_stderr2("updateStateValue('%s'): %lu bytes is too long for the queue",
+                      key, (unsigned long)std::strlen(value));
+            return false;
+        }
+
+        const uint32_t next = (fStateQueueWrite + 1) % kStateQueueSize;
+        if (next == fStateQueueRead)
+            return false;                        // full: drop it rather than block
+
+        StateMessage& msg(fStateQueue[fStateQueueWrite]);
+        std::strcpy(msg.key, key);
+        std::strcpy(msg.value, value);
+        fStateQueueWrite = next;
+        return true;
+       #else
+        // Nothing to push to.
+        return false;
+        (void)key; (void)value;
+       #endif
+    }
+
+    static bool updateStateValueCallback(void* const ptr, const char* const key, const char* const value)
+    {
+        return static_cast<PluginVst3*>(ptr)->updateStateValue(key, value);
+    }
+   #endif
